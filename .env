# Configuração pública (sem segredos). Sobrescreva em .env.local ou nas variáveis do host.

# Endpoint consumido pelo front. Em dev/preview e no deploy, /api/products é
# reescrito para o JSON da Econverse (que não envia header CORS).
VITE_PRODUCTS_URL=/api/products

# URL pública do site: usada em canonical, Open Graph e JSON-LD (index.html).
VITE_SITE_URL=https://econverse-front.vercel.app

# (opcional) origem usada pelo proxy do Vite em dev/preview
# PRODUCTS_UPSTREAM_URL=https://app.econverse.com.br/teste-front-end/junior/tecnologia/lista-produtos/produtos.json
